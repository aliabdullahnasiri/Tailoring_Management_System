{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thread & Ledger",
  "version": "1.0.0",
  "identifier": "com.threadandledger.tailoring",
  "build": {
    "beforeDevCommand": {
      "script": "npm run desktop:prepare",
      "wait": true
    },
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Local tailoring shop management",
    "externalBin": [
      "binaries/tms-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
